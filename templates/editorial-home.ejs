<!doctype html>
<html lang="<%= editorial.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="<%= editorial.variant === 'factory' ? '#10263d' : '#132b28' %>">
  <title><%= editorial.name %> · <%= editorial.eyebrow %></title>
  <meta name="description" content="<%= editorial.description %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= editorial.name %>">
  <meta property="og:title" content="<%= editorial.name %> · <%= editorial.eyebrow %>">
  <meta property="og:description" content="<%= editorial.description %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= new URL('img/' + editorial.image, canonical).href %>">
  <meta property="og:image:alt" content="<%= editorial.imageAlt %>">
  <link rel="icon" href="/img/favicon.ico">
  <link rel="stylesheet" href="/css/editorial.css">
  <meta name="google-adsense-account" content="ca-pub-7465624411296700">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7465624411296700" crossorigin="anonymous"></script>
  <script defer src="/js/editorial-search.js"></script>
</head>
<body class="editorial editorial--<%= editorial.variant %>">
  <a class="journal-skip" href="#main-content"><%= editorial.skip %></a>
  <header class="journal-header">
    <div class="journal-wrap journal-header__inner">
      <a class="journal-brand" href="/" aria-current="page">
        <span class="journal-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span><strong><%= editorial.name %></strong><small><%= editorial.shortName %></small></span>
      </a>
      <nav aria-label="<%= editorial.navLabel %>">
        <a href="/archives/"><%= editorial.articles %></a>
        <a href="/categories/"><%= editorial.categories %></a>
        <a href="/about/"><%= editorial.about %></a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="journal-wrap">
    <section class="journal-hero">
      <div class="journal-hero__copy">
        <p class="journal-kicker"><%= editorial.eyebrow %></p>
        <h1><%= editorial.heading %></h1>
        <p class="journal-hero__summary"><%= editorial.intro %></p>
        <div class="journal-hero__actions">
          <a class="journal-button journal-button--solid" href="#articles"><%= editorial.primary %></a>
          <a class="journal-button journal-button--outline" href="https://proengineercalc.xyz/"><%= editorial.secondary %></a>
        </div>
      </div>
      <figure class="journal-hero__visual">
        <img src="/img/<%= editorial.image %>" alt="<%= editorial.imageAlt %>" width="1536" height="1024" fetchpriority="high">
        <figcaption><%= editorial.imageCaption %></figcaption>
      </figure>
    </section>

    <section class="journal-topics" aria-labelledby="topic-title">
      <h2 id="topic-title"><%= editorial.focus %></h2>
      <div class="journal-topics__grid">
        <% for (const topic of editorial.topics) { %>
        <a class="journal-topic" href="<%= topic.url %>">
          <span class="journal-topic__mark" aria-hidden="true"></span>
          <h3><%= topic.title %></h3>
          <p><%= topic.text %></p>
        </a>
        <% } %>
      </div>
    </section>

    <section class="journal-library" id="articles" aria-labelledby="article-title" data-journal-library data-matches="<%= editorial.results %>">
      <div class="journal-section-head">
        <div>
          <h2 id="article-title"><%= editorial.library %></h2>
          <a class="journal-text-link" href="/archives/"><%= editorial.archive %></a>
        </div>
        <div class="journal-search" hidden data-journal-search>
          <label for="journal-query"><%= editorial.searchLabel %></label>
          <input type="search" id="journal-query" placeholder="<%= editorial.searchPlaceholder %>" aria-controls="journal-stories" autocomplete="off">
        </div>
      </div>
      <p class="journal-status" aria-live="polite" data-journal-status></p>
      <div class="journal-stories" id="journal-stories">
        <% for (const [index, post] of posts.entries()) { %>
        <article class="journal-story" data-search="<%= post.search %>" <% if (index >= 6) { %>hidden<% } %>>
          <div class="journal-story__meta">
            <% if (post.category) { %><span><%= post.category %></span><% } %>
            <time datetime="<%= post.date %>"><%= post.date %></time>
          </div>
          <h3><a href="<%= post.url %>"><%= post.title %></a></h3>
          <span class="journal-story__action" aria-hidden="true"><%= editorial.read %></span>
        </article>
        <% } %>
      </div>
      <p class="journal-empty" data-journal-empty hidden><%= editorial.empty %></p>
      <% if (posts.length > 6) { %>
      <button class="journal-button journal-button--more" type="button" data-journal-more data-show="<%= editorial.more %>" data-hide="<%= editorial.less %>" aria-expanded="false" aria-controls="journal-stories" hidden><%= editorial.more %></button>
      <% } %>
    </section>
  </main>

  <footer class="journal-footer">
    <div class="journal-wrap journal-footer__inner">
      <strong><%= editorial.name %></strong>
      <nav aria-label="<%= editorial.legalLabel %>">
        <a href="<%= editorial.relatedUrl %>" <% if (editorial.variant === 'smart') { %>hreflang="zh-CN"<% } else { %>hreflang="en"<% } %>><%= editorial.related %></a>
        <a href="/terms/"><%= editorial.terms %></a>
        <a href="/privacy/"><%= editorial.privacy %></a>
      </nav>
    </div>
  </footer>
</body>
</html>
